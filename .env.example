# MM — Music Maker
# 100% local — zero API calls

DATABASE_URL=postgresql://mm:mm_dev_password@localhost:5432/mm_dev
REDIS_URL=redis://localhost:6379/0

# Local LLM (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_MODEL_QUALITY=qwen2.5:32b

# Storage
STORAGE_PATH=./storage

# GPU Assignment (dual-GPU strategy)
# GPU 0 = voice / persona / LLM
# GPU 1 = audio / separation / alignment
GPU_VOICE=0
GPU_AUDIO=1

# Quality: "draft" (fast) or "render" (clean)
DEFAULT_QUALITY=draft

# TTS engine: "xtts" or fallback
TTS_ENGINE=xtts

# Azure Speech (optional cloud voice — local XTTS is default)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

SECRET_KEY=change-me-in-production
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
